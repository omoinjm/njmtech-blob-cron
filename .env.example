# Vercel Blob Storage Configuration
# Your Vercel project's Blob API URL.
BLOB_API_URL="your_blob_api_url"
# A Vercel API token with read/write access to the Blob store.
VERCEL_BLOB_TOKEN="your_vercel_blob_token"
# The ID of your Vercel Blob store.
BLOB_STORE_ID="your_blob_store_id"

# AI Model Configuration (Ollama)
# The ID of the Ollama model to use for transformation (e.g., llama3.2, mistral-nemo).
OLLAMA_MODEL_ID="llama3.2"
# The base URL of your running Ollama instance.
OLLAMA_BASE_URL="http://localhost:11434"

# Scanner Configuration
# The root folder within the Vercel Blob store to begin scanning from.
ROOT_SCAN_FOLDER="njmtech-blob-api"
